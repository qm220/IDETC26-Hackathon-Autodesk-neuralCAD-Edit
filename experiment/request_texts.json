    }
  },
  {
    "id": "B7A2N74ZJBF9MZHU_1770174308.67968",
    "text": "Add two horizontal buttons to the front panel. One above existing one, the other below - all approximately equally distanced. Buttons should be copies of existing one.",
    "brep_start": "B7A2N74ZJBF9MZHU_1770174381.837417",
    "brep_path": "B7A2N74ZJBF9MZHU_1770174381.837417.step",
