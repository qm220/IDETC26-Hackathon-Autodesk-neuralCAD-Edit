  },
  {
    "id": "ZK22J6VYRKQ2RTFD_1758874422.1403751",
    "text": "Add a connecting hole of 1.7 millimetre diameter and apply 0.1 millimetre grooves to increase grip and prevent slipping.",
    "brep_start": "ZK22J6VYRKQ2RTFD_1758874483.146758",
    "brep_path": "ZK22J6VYRKQ2RTFD_1758874483.146758.step",
