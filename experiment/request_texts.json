      "gpt-5.2_cadquery-script": "gpt-5.2_cadquery-script_1771051108.774542.step",
      "claude-sonnet-4.5_cadquery-script": "claude-sonnet-4.5_cadquery-script_1771452735.50753.step"
    }
  },
  {
    "id": "F332D3FXML85WLR2_1770206307.074256",
    "text": "Scale the part 10x. Add drafts of 2 degrees to all vertical surfaces, with flat bottom surface as a hinge. Add rounds R=1mm to all inner edges and R=3mm to all outer edges. Exclude edges, inner or outer, on the flat bottom surface. Add two cylinder features with D=6mm and inner hole D=3mm. Cylinders should be spaced 30mm apart and shall be placed centered with respect to the main part. They should start on the flat bottom surface level and reach all the way to the part wall on the top side",
    "brep_start": "F332D3FXML85WLR2_1770206316.138211",
    "brep_path": "F332D3FXML85WLR2_1770206316.138211.step",
    "brep_end": [
      "DYP2J9CYL7X46RLQ_1770277706.235426.step",
      "F332D3FXML85WLR2_1770206810.449016.step"
